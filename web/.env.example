# Copy to web/.env.local (gitignored). Set the same names in Vercel → Project → Settings → Environment Variables.
# Never commit real values or paste them into chat.

# testnet (default) | mainnet | local (dev only: an arc-anvil fork on 127.0.0.1:8545 with two test wallets)
# Always set it for real builds: it's read at build time, and setting it strips the dev-only test wallet code.
NEXT_PUBLIC_ARC_NETWORK=testnet

# Your site's address (metadata, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → Data API (URL) and API Keys (service_role / secret key). SERVER ONLY:
# never prefix these with NEXT_PUBLIC_. Without them the app still works; uploads, downloads and shared
# titles/notes are switched off.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs login cookies. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
