# Copy to web/.env.local (gitignored). Set the same values in Vercel → Project → Settings → Environment Variables.

# testnet (default) | mainnet | local (dev only: an arc-anvil fork on 127.0.0.1:8545 with two test wallets)
# Always set it for real builds: it's read at build time, and setting it strips the dev-only test wallet code.
NEXT_PUBLIC_ARC_NETWORK=testnet

# Your site's address (used for share links and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 4 (Supabase), not needed yet:
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   (server-only secret: never prefix with NEXT_PUBLIC_)
# SESSION_SECRET=
