# Copy to contracts/.env (gitignored). arc-forge loads it automatically.

# Set to true to also run the Arc Testnet fork tests (real USDC system contract, needs internet).
ARC_FORK=false

# Only if you deploy with a plain private key instead of the encrypted keystore (SETUP.md A4).
# Only after the project is out of OneDrive (SETUP.md B1). Never paste this into chat.
PRIVATE_KEY=
